# Mail provider: none | gmail-api | smtp | sendgrid | resend
MAIL_PROVIDER=none

# Common "From" identity
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Pura Vida PC

# Gmail API (OAuth2 refresh token flow)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# SMTP Gmail (alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# SendGrid (alternative)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# Resend (alternative)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Pura Vida PC

